# =======================================================================
# MKA ENERGY SOLUTION (PT MITRA KARYA AUSINDO) - CPANEL .HTACCESS CONFIG
# Domain: www.mkaenergy.co.id
# Fitur: Permalink Ramah SEO, Kompresi Gzip, Keamanan & Caching Browser
# =======================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Paksa Protokol HTTPS Otomatis
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Routing API endpoint ke api.php jika diawali /api/
  RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

  # 3. Sajikan file & folder aset asli secara langsung tanpa rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback ke index.html untuk Single Page Application (SPA Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Pastikan MIME Type JavaScript & CSS dikenali Apache dengan benar
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# 5. Optimasi Kompresi GZIP untuk Performa Loading Cepat
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 6. Header Keamanan
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Browser Cache Expiry
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
